# Copy to .env.local (web) / .env (jobs). Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# HMAC secret for /go/{click_id} affiliate redirects
AFFILIATE_CLICK_SECRET=replace-me-with-32-plus-chars

# Optional: jobs connecting through the pooler
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me
